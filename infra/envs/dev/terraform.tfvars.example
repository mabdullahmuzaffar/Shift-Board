# cp terraform.tfvars.example terraform.tfvars && fill in.
# terraform.tfvars is gitignored.
#
# Discover the values you need:
#   az account show --query '{sub:id, tenant:tenantId}' -o json
#   az ad group show --group "ShiftBoard AKS Admins" --query id -o tsv
#   az ad group show --group "ShiftBoard SQL Admins" --query id -o tsv

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "11111111-1111-1111-1111-111111111111"
location        = "westeurope"

# Makes globally-unique names yours. Change this before applying.
name_suffix = "ar01"

aks_admin_group_object_ids = ["22222222-2222-2222-2222-222222222222"]

sql_admin_group_name      = "ShiftBoard SQL Admins"
sql_admin_group_object_id = "33333333-3333-3333-3333-333333333333"

oncall_emails = {
  primary = "you@example.com"
}

# An idle dev cluster still bills. Keep this set.
monthly_budget_amount = 150

pipeline_principal_ids = {
  # azure-devops = "44444444-4444-4444-4444-444444444444"
}
